# Copy to .env (never committed). Environment variables override this file.
# Any Ollama-compatible endpoint works: the laptop's own Ollama (default) or a private server.
BIST_LLM_BASE_URL=http://127.0.0.1:11434
BIST_LLM_MODEL=qwen3.5:9b-q4_K_M
# Route on that server: ollama (native /api/chat, default) or openai (/v1/chat/completions,
# for a gateway that passes only the OpenAI-compatible route)
# BIST_LLM_API=ollama
# Optional: where cached market data lives (default: ./data)
# BIST_DATA_DIR=
